# --- Environment / secrets ---
# Never commit credentials. The challenge is 100% offline and uses
# synthetic data only; no real secrets belong in this repository.
.env
.env.*
!.env.example
*.pem
*.key

# --- Editors / OS ---
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# --- Run artifacts ---
# Traces are regenerated by `sentinel run` / `sentinel eval`.
# The reference traces referenced by the technical report are force-added
# (see README) so the jury can replay them without re-running the simulator.
artifacts/
scorecard.json

